# Shopify headless — Storefront API
# Copy to .env.local (local) and add the same vars in Vercel → Project → Settings → Environment Variables.

# Your store's myshopify domain (NOT the custom domain)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Public Storefront API access token (safe for client use)
# Shopify Admin → Settings → Apps → Develop apps → your app → API credentials
SHOPIFY_STOREFRONT_TOKEN=your_storefront_access_token
